                                    "chunk_overlap": {
                                        "type": "integer",
                                        "description": "Overlap between chunks (default: 200)",
                                        "default": 200
                                    }
                                },
                                "required": ["file_path"]
                            }
                        },
                        {
                            "name": "ingest_text_content",
                            "description": "Ingest raw text content directly into the memory system",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "content": {
                                        "type": "string",
                                        "description": "Text content to ingest"
                                    },
                                    "source_name": {
                                        "type": "string",
                                        "description": "Name/source identifier for the content"
                                    },
                                    "domain": {
                                        "type": "string",
                                        "description": "Memory domain to store in (default: 'documents')",
                                        "default": "documents"
                                    }
                                },
                                "required": ["content", "source_name"]
                            }
                        }
                    ]
                }
            }
        
        elif request.method == "tools/call":
            tool_name = request.params.get("name")
            args = request.params.get("arguments", {})

            # Handle different MCP tools
            if tool_name == "retrieve_memory":
                # Extract query parameters
                query = args.get("query", "")
                n_results = args.get("n_results", 10)
                domain = args.get("domain", "default")

                # Retrieve memories
                memories = memory_api.retrieve_memories(
                    query=query,
                    limit=n_results,
                    domain=domain
                )

                # Format response for hooks
                formatted_memories = []
                for mem in memories:
                    created_at = mem.get("created_at")
                    created_at_iso = created_at.isoformat() if hasattr(created_at, 'isoformat') else str(created_at) if created_at else None

                    formatted_memories.append({
                        "id": mem.get("id"),
                        "content": mem.get("content"),
                        "metadata": mem.get("metadata", {}),
                        "score": mem.get("score", 0),
                        "created_at": created_at,
                        "created_at_iso": created_at_iso
                    })

                # Return MCP-style response
                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({
                                "results": formatted_memories,
                                "memories": formatted_memories
                            }, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "search_memories":
                # Extract query parameters
                query = args.get("query", "")
                limit = args.get("limit", 10)
                domain = args.get("domain", "default")

                # Search memories
                memories = memory_api.retrieve_memories(
                    query=query,
                    limit=limit,
                    domain=domain
                )

                # Format response for hooks
                formatted_memories = []
                for mem in memories:
                    created_at = mem.get("created_at")
                    created_at_iso = created_at.isoformat() if hasattr(created_at, 'isoformat') else str(created_at) if created_at else None

                    formatted_memories.append({
                        "id": mem.get("id"),
                        "content": mem.get("content"),
                        "metadata": mem.get("metadata", {}),
                        "score": mem.get("score", 0),
                        "created_at": created_at,
                        "created_at_iso": created_at_iso
                    })

                # Return MCP-style response
                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({
                                "results": formatted_memories,
                                "memories": formatted_memories
                            }, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "update_memory":
                # Extract parameters
                memory_id = args.get("memory_id")
                content = args.get("content")
                importance = args.get("importance")
                domain = args.get("domain", "default")

                # Update memory
                result = memory_api.update_memory(
                    memory_id=memory_id,
                    content=content,
                    importance=importance,
                    domain=domain
                )

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({"success": result}, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "recall_memory":
                # Extract parameters
                query = args.get("query", "")
                n_results = args.get("n_results", 5)

                # Recall memories
                memories = memory_api.recall_memories(
                    query=query,
                    limit=n_results
                )

                # Format response
                formatted_memories = []
                for mem in memories:
                    created_at = mem.get("created_at")
                    created_at_iso = created_at.isoformat() if hasattr(created_at, 'isoformat') else str(created_at) if created_at else None

                    formatted_memories.append({
                        "id": mem.get("id"),
                        "content": mem.get("content"),
                        "metadata": mem.get("metadata", {}),
                        "score": mem.get("score", 0),
                        "created_at": created_at,
                        "created_at_iso": created_at_iso
                    })

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({"memories": formatted_memories}, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "search_by_tag":
                # Extract parameters
                tags = args.get("tags", [])
                domain = args.get("domain", "default")
                limit = args.get("limit", 5)

                # Search by tags
                memories = memory_api.search_by_tags(
                    tags=tags,
                    domain=domain,
                    limit=limit
                )

                # Format response
                formatted_memories = []
                for mem in memories:
                    created_at = mem.get("created_at")
                    created_at_iso = created_at.isoformat() if hasattr(created_at, 'isoformat') else str(created_at) if created_at else None

                    formatted_memories.append({
                        "id": mem.get("id"),
                        "content": mem.get("content"),
                        "metadata": mem.get("metadata", {}),
                        "score": mem.get("score", 0),
                        "created_at": created_at,
                        "created_at_iso": created_at_iso
                    })

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({"memories": formatted_memories}, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "list_memory_domains":
                # List domains
                domains = memory_api.list_domains()

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({"domains": domains}, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "delete_memory":
                # Extract parameters
                memory_id = args.get("memory_id")
                domain = args.get("domain", "default")

                # Delete memory
                result = memory_api.delete_memory(
                    memory_id=memory_id,
                    domain=domain
                )

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({"success": result}, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "delete_by_tag":
                # Extract parameters
                tags = args.get("tags", [])
                domain = args.get("domain", "default")

                # Delete by tags
                count = memory_api.delete_by_tags(
                    tags=tags,
                    domain=domain
                )

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({"deleted_count": count}, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "get_current_project_domain":
                # Get current project domain
                domain = memory_api.get_current_project_domain()

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({"domain": domain}, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "create_domain":
                # Extract parameters
                domain_name = args.get("domain_name")

                # Create domain
                result = memory_api.create_domain(domain_name)

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({"success": result}, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "get_domain_info":
                # Extract parameters
                domain_name = args.get("domain_name")

                # Get domain info
                info = memory_api.get_domain_info(domain_name)

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps(info, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "switch_to_domain":
                # Extract parameters
                domain_name = args.get("domain_name")

                # Switch domain
                result = memory_api.switch_to_domain(domain_name)

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps(result, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "copy_memories_between_domains":
                # Extract parameters
                source_domain = args.get("source_domain")
                target_domain = args.get("target_domain")
                query = args.get("query")
                limit = args.get("limit")

                # Copy memories
                result = memory_api.copy_memories_between_domains(
                    source_domain=source_domain,
                    target_domain=target_domain,
                    query=query,
                    limit=limit
                )

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps(result, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "ingest_document":
                # Extract parameters
                file_path = args.get("file_path")
                domain = args.get("domain", "documents")
                chunk_size = args.get("chunk_size", 1000)
                chunk_overlap = args.get("chunk_overlap", 200)

                # Ingest document
                result = memory_api.ingest_document(
                    file_path=file_path,
                    domain=domain,
                    chunk_size=chunk_size,
                    chunk_overlap=chunk_overlap
                )

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({"result": result}, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "ingest_text_content":
                # Extract parameters
                content = args.get("content")
                source_name = args.get("source_name")
                domain = args.get("domain", "documents")

                # Ingest text content
                result = memory_api.ingest_text_content(
                    content=content,
                    source_name=source_name,
                    domain=domain
                )

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({"result": result}, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "store_memory":
                # Extract parameters
                content = args.get("content", "")
                domain = args.get("domain", "default")
                source = args.get("source")
                importance = args.get("importance")

                # Prepare metadata
                metadata = {}
                if source:
                    metadata["source"] = source
                if importance is not None:
                    metadata["importance"] = importance

                # Store memory
                memory_id = memory_api.store_memory(content, metadata, domain)

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({
                                "memory_id": memory_id,
                                "success": True
                            }, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "list_memory_domains":
                # List available domains
                domains = memory_api.list_domains()

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({
                                "domains": domains
                            }, cls=CustomJSONEncoder)
                        }]
                    }
                }

            elif tool_name == "retrieve_memory":
                # Retrieve memories with L1 cache (alias for search_memories for doobidoo compatibility)
                query = params.get("query", "")
                domain = params.get("domain", "default")
                n_results = params.get("n_results", 10)

                # Check L1 cache first
                cached_memories = memory_cache.get(query, domain, n_results)
                if cached_memories is not None:
                    formatted_memories = cached_memories
                else:
                    # Cache miss - query database
                    try:
                        result = memory_api.search_memories(query, domain=domain, limit=n_results)
                        memories = result.get("memories", [])

                        # Format memories for session-start hook compatibility
                        formatted_memories = []
                        for memory in memories:
                            formatted_memory = {
                                "id": memory.get("id"),
                                "content": memory.get("content"),
                                "metadata": memory.get("metadata", {}),
                                "score": memory.get("score", 0.0)
                            }

                            # Convert timestamp to ISO string for created_at_iso
                            metadata = memory.get("metadata", {})
                            if metadata and "created_at" in metadata:
                                timestamp = metadata["created_at"]
                                formatted_memory["created_at"] = timestamp
                                formatted_memory["created_at_iso"] = datetime.fromtimestamp(timestamp).isoformat()
                            else:
                                formatted_memory["created_at"] = None
                                formatted_memory["created_at_iso"] = None

                            formatted_memories.append(formatted_memory)

                        # Cache the formatted result for future requests
                        memory_cache.put(query, formatted_memories, domain, n_results)
                    except Exception as e:
                        # Return empty result on database error
                        formatted_memories = []

                return {
                    "jsonrpc": "2.0",
                    "id": request.id,
                    "result": {
                        "content": [{
                            "type": "text",
                            "text": json.dumps({
                                "memories": formatted_memories,
                                "count": len(formatted_memories)
                            }, cls=CustomJSONEncoder)
                        }]
                    }
                }

            else:
                raise HTTPException(status_code=400, detail=f"Unknown tool: {tool_name}")
        else:
            raise HTTPException(status_code=400, detail=f"Unknown method: {request.method}")

    except Exception as e:
        return {
            "jsonrpc": "2.0",
            "id": request.id,
            "error": {
                "code": -32603,
                "message": str(e)
            }
        }

if __name__ == "__main__":
    # Use fixed port 8000 or environment override
    port = int(os.environ.get("BRIDGE_PORT", 8000))

    print(f"🌐 Bridge server starting on port {port}")

    # Run the server
    uvicorn.run(
        app,
        host="0.0.0.0",
        port=port,
        log_level="info"
    )