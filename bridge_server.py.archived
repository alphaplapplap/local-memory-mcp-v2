        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to get project domain: {str(e)}")

@app.post("/api/memories")
async def store_memory(request: MemoryStoreRequest):
    """Store a memory via HTTP (for hooks)"""
    try:
        # Prepare metadata with tags
        metadata = request.metadata or {}
        if request.tags:
            metadata["tags"] = request.tags

        # Store memory
        memory_id = memory_api.store_memory(
            content=request.content,
            metadata=metadata,
            domain=request.domain
        )

        return {
            "success": True,
            "memory_id": memory_id,
            "message": "Memory stored successfully"
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/memories")
async def retrieve_memories(query: str = "", domain: str = "default", limit: int = 10):
    """Retrieve memories via HTTP with L1 cache (for testing/debugging)"""
    try:
        start_time = time.time()
        performance_metrics["queries_total"] += 1
        
        # Check L1 cache first
        cached_result = memory_cache.get(query, domain, limit)
        if cached_result is not None:
            performance_metrics["cache_hits"] += 1
            return {
                "success": True,
                "memories": cached_result,
                "count": len(cached_result),
                "cache_hit": True
            }

        # Cache miss - query database
        performance_metrics["cache_misses"] += 1
        memories = memory_api.retrieve_memories(
            query=query,
            limit=limit,
            domain=domain
        )

        # Cache the result
        memory_cache.put(query, memories, domain, limit)
        
        # Track query time
        query_time = (time.time() - start_time) * 1000
        if query_time > 1000:
            performance_metrics["slow_queries"] += 1
        
        # Update average response time
        current_avg = performance_metrics["avg_response_ms"]
        total_queries = performance_metrics["queries_total"]
        performance_metrics["avg_response_ms"] = ((current_avg * (total_queries - 1)) + query_time) / total_queries

        return {
            "success": True,
            "memories": memories,
            "count": len(memories),
            "cache_hit": False,
            "query_time_ms": round(query_time, 2)
        }
    except Exception as e:
        performance_metrics["query_errors"] += 1
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/mcp")
async def mcp_endpoint(request: MCPRequest):
    """
    MCP protocol endpoint for memory retrieval
    Handles tools/call method for retrieve_memory
    """
    try:
        if request.method == "initialize":
            # MCP initialization response
            return {
                "jsonrpc": "2.0",
                "id": request.id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {
                        "tools": {
                            "listChanged": False
                        }
                    },
                    "serverInfo": {
                        "name": "local-memory-mcp",
                        "version": "1.0.0"
                    }
                }
            }
        
        elif request.method == "tools/list":
            # Return available tools
            return {
                "jsonrpc": "2.0",
                "id": request.id,
                "result": {
                    "tools": [
                        {
                            "name": "retrieve_memory",
                            "description": "Retrieve memories from the local memory system using semantic search",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "query": {
                                        "type": "string",
                                        "description": "The search query to find relevant memories"
                                    },
                                    "n_results": {
                                        "type": "integer",
                                        "description": "Number of results to return (default: 10)",
                                        "default": 10
                                    },
                                    "domain": {
                                        "type": "string",
                                        "description": "The domain to search in (default: 'default')",
                                        "default": "default"
                                    }
                                },
                                "required": ["query"]
                            }
                        },
                        {
                            "name": "search_memories",
                            "description": "Search memories from the local memory system using semantic search",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "query": {
                                        "type": "string",
                                        "description": "The search query to find relevant memories"
                                    },
                                    "limit": {
                                        "type": "integer",
                                        "description": "Number of results to return (default: 10)",
                                        "default": 10
                                    },
                                    "domain": {
                                        "type": "string",
                                        "description": "The domain to search in (default: 'default')",
                                        "default": "default"
                                    }
                                },
                                "required": ["query"]
                            }
                        },
                        {
                            "name": "store_memory",
                            "description": "Store new information with optional tags and metadata",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "content": {
                                        "type": "string",
                                        "description": "The content of the memory to store"
                                    },
                                    "domain": {
                                        "type": "string",
                                        "description": "The domain to store the memory in (default: 'default')",
                                        "default": "default"
                                    },
