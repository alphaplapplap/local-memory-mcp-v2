#!/usr/bin/env python3
"""
HTTP API Bridge Server for Claude Hooks
Provides HTTP endpoints that bridge to PostgreSQL memory storage
"""

import os
import sys
import json
import uuid
import asyncio
import time
import uvicorn
from decimal import Decimal
from datetime import datetime
from typing import Dict, List, Any, Optional
from fastapi import FastAPI, HTTPException, Request, Response
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from dotenv import load_dotenv
from contextlib import asynccontextmanager

# urllib3 1.x doesn't have SSL warnings with LibreSSL

# Custom JSON encoder for Decimal and other types
class CustomJSONEncoder(json.JSONEncoder):
    def default(self, obj):
        if isinstance(obj, Decimal):
            return float(obj)
        if isinstance(obj, datetime):
            return obj.isoformat()
        return super().default(obj)

# Add src to path
sys.path.insert(0, 'src')

from postgres_memory_api import PostgresMemoryAPI, get_project_domain
from ollama_embeddings import OllamaEmbeddings
from adaptive_lru_cache import memory_cache
from connection_pool import initialize_connection_pool, get_connection_pool, get_health_checker

# Load environment variables
load_dotenv()

# Performance metrics
performance_metrics = {
    "queries_total": 0,
    "query_errors": 0,
    "avg_response_ms": 0,
    "memory_count": 0,
    "db_size_mb": 0,
    "cache_hits": 0,
    "cache_misses": 0,
    "slow_queries": 0,  # Queries > 1s
    "startup_time": datetime.now()
}

# Initialize Ollama configuration
ollama_url = os.getenv("OLLAMA_API_URL", "http://localhost:11434")
embedding_model = os.getenv("OLLAMA_EMBEDDING_MODEL", "nomic-embed-text:v1.5")

# Define lifespan function
@asynccontextmanager
async def lifespan(app: FastAPI):
    # Startup
    print("🚀 Memory Bridge API Server starting...")
    print(f"📊 PostgreSQL: {os.getenv('POSTGRES_HOST', 'localhost')}:{os.getenv('POSTGRES_PORT', 5432)}")
    print(f"🧠 Ollama: {ollama_url} ({embedding_model})")
    print(f"🌐 Listening on: http://localhost:8000")
    print("🔄 Hot reloading: ENABLED (Development Mode)")
    
    # Initialize connection pool
    try:
        connection_params = {
            'host': os.getenv('POSTGRES_HOST', 'localhost'),
            'port': int(os.getenv('POSTGRES_PORT', 5432)),
            'database': os.getenv('POSTGRES_DB', 'postgres'),
            'user': os.getenv('POSTGRES_USER', 'postgres'),
            'password': os.getenv('POSTGRES_PASSWORD', 'postgres')
        }
        pool = initialize_connection_pool(
            connection_params,
            min_connections=int(os.getenv('POOL_MIN_CONNECTIONS', 2)),
            max_connections=int(os.getenv('POOL_MAX_CONNECTIONS', 20))
        )
        print(f"✅ Connection pool initialized: {pool.get_pool_status()}")
    except Exception as e:
        print(f"⚠️ Failed to initialize connection pool: {e}")
    
    yield
    
    # Shutdown
    print("👋 Memory Bridge API Server shutting down...")
    pool = get_connection_pool()
    if pool:
        pool.close_all_connections()

# Initialize FastAPI app with lifespan
app = FastAPI(title="Memory Bridge API", version="1.0.0", lifespan=lifespan)

# Add CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Initialize Ollama embeddings if available

try:
    import requests
    response = requests.get(f"{ollama_url}/api/tags", timeout=2)
    if response.status_code == 200:
        models = response.json().get("models", [])
        model_names = [model.get("name", "") for model in models]
        if embedding_model in model_names:
            ollama_embeddings = OllamaEmbeddings(
                model_name=embedding_model,
                base_url=ollama_url,
                keep_alive="10m"
            )
            print(f"✅ Ollama embeddings initialized with {embedding_model}")
        else:
            ollama_embeddings = None
            print(f"⚠️ Embedding model {embedding_model} not found, using text search")
    else:
        ollama_embeddings = None
        print("⚠️ Ollama not available, using text search")
except Exception as e:
    ollama_embeddings = None
    print(f"⚠️ Ollama check failed: {e}")

# Initialize PostgreSQL API
memory_api = PostgresMemoryAPI(ollama_embeddings=ollama_embeddings)

# Request/Response models
class MemoryStoreRequest(BaseModel):
    content: str
    metadata: Optional[Dict[str, Any]] = {}
    domain: Optional[str] = None  # Changed from "default" to None to enable auto-detection
    tags: Optional[List[str]] = []

class MCPRequest(BaseModel):
    jsonrpc: str = "2.0"
    id: int = 1
    method: str
    params: Dict[str, Any]

@app.get("/")
async def root():
    """Root endpoint"""
    return {
        "service": "Memory Bridge API",
        "version": "1.0.0",
        "status": "running",
        "endpoints": [
            "/api/health",
            "/api/memories",
            "/mcp"
        ]
    }

@app.get("/api/health")
async def health_check():
    """Health check endpoint for hooks"""
    try:
        start_time = time.time()
        
        # Get memory statistics
        domains = memory_api.list_domains()

        # Count total memories across domains
        total_memories = 0
        domain_stats = []

        # Use connection pool
        pool = get_connection_pool()
        if pool:
            with pool.get_cursor() as cursor:
                # Get total database size in MB
                cursor.execute("SELECT pg_database_size('postgres') / 1024.0 / 1024.0")
                database_size_mb = round(cursor.fetchone()[0], 2)

                # Count tags across all domains
                all_tags = set()
                
                for domain in domains:
                    table_name = f"{domain}_memories"
                    cursor.execute(f'SELECT COUNT(*) FROM "{table_name}"')
                    count = cursor.fetchone()[0]
                    total_memories += count

                    # Count tags in this domain
                    cursor.execute(f'SELECT metadata FROM "{table_name}" WHERE metadata ? \'tags\'')
                    rows = cursor.fetchall()
                    for row in rows:
                        metadata = row[0]
                        if 'tags' in metadata and metadata['tags']:
                            all_tags.update(metadata['tags'])

                    domain_stats.append({
                        "domain": domain,
                        "count": count
                    })
        else:
            # Fallback to direct connection
            import psycopg2
            conn = psycopg2.connect(
                host=os.getenv('POSTGRES_HOST', 'localhost'),
                port=os.getenv('POSTGRES_PORT', 5432),
                database=os.getenv('POSTGRES_DB', 'postgres'),
                user=os.getenv('POSTGRES_USER', 'postgres'),
                password=os.getenv('POSTGRES_PASSWORD', 'postgres')
            )
            with conn.cursor() as cursor:
                cursor.execute("SELECT pg_database_size('postgres') / 1024.0 / 1024.0")
                database_size_mb = round(cursor.fetchone()[0], 2)
                all_tags = set()
                for domain in domains:
                    table_name = f"{domain}_memories"
                    cursor.execute(f'SELECT COUNT(*) FROM "{table_name}"')
                    count = cursor.fetchone()[0]
                    total_memories += count
                    domain_stats.append({"domain": domain, "count": count})
            conn.close()
            
        unique_tags_count = len(all_tags)
        
        # Update metrics
        performance_metrics["memory_count"] = total_memories
        performance_metrics["db_size_mb"] = database_size_mb
        
        # Track query time
        query_time = (time.time() - start_time) * 1000
        if query_time > 1000:
            performance_metrics["slow_queries"] += 1

        return {
            "status": "healthy",
            "storage": {
                "backend": "postgresql",
                "type": "local",
                "status": "connected",
                "accessible": True,
                "database_path": f"postgresql://localhost:5432/{os.getenv('POSTGRES_DB', 'postgres')}",
                "total_memories": total_memories,
                "unique_tags": unique_tags_count,
                "embedding_model": embedding_model if ollama_embeddings else "none",
                "domains": domain_stats
            },
            "system": {
                "platform": os.uname().sysname.lower(),
                "version": "1.0.0"
            },
            "statistics": {
                "total_memories": total_memories,
                "database_size_mb": database_size_mb,
                "unique_tags": unique_tags_count
            },
            "uptime_seconds": 0,  # TODO: Track uptime
            "timestamp": datetime.now().isoformat()
        }
    except Exception as e:
        return {
            "status": "error",
            "error": str(e),
            "storage": {
                "backend": "postgresql",
                "status": "disconnected"
            }
        }

@app.get("/api/health/detailed")
async def health_check_detailed():
    """Detailed health check with cache metrics"""
    base_health = await health_check()

    # Add cache health information
    cache_stats = memory_cache.get_stats()
    cache_health = memory_cache.get_health_status()

    base_health["cache"] = {
        "status": cache_health["status"],
        "health_score": cache_health["health_score"],
        "statistics": cache_stats,
        "issues": cache_health["issues"],
        "recommendations": cache_health["recommendations"]
    }

    return base_health

@app.get("/api/cache/stats")
async def get_cache_stats():
    """Get detailed cache statistics"""
    return {
        "cache_stats": memory_cache.get_stats(),
        "cache_health": memory_cache.get_health_status()
    }

@app.get("/api/metrics")
async def get_metrics():
    """Get performance metrics"""
    uptime = (datetime.now() - performance_metrics["startup_time"]).total_seconds()
    
    # Check for performance issues
    alerts = []
    if performance_metrics["avg_response_ms"] > 2000:
        alerts.append("High average response time (>2s)")
    if performance_metrics["memory_count"] > 10000:
        alerts.append("Large memory count - consider consolidation")
    if performance_metrics["db_size_mb"] > 1000:
        alerts.append("Large database size (>1GB)")
    if performance_metrics["query_errors"] > 10:
        alerts.append("High error rate")
    
    # Get connection pool status
    pool = get_connection_pool()
    pool_status = pool.get_pool_status() if pool else None
    
    # Get cache hit rate
    cache_hit_rate = 0
    total_cache_requests = performance_metrics["cache_hits"] + performance_metrics["cache_misses"]
    if total_cache_requests > 0:
        cache_hit_rate = (performance_metrics["cache_hits"] / total_cache_requests) * 100
    
    return {
        "uptime_seconds": uptime,
        "metrics": performance_metrics,
        "cache_hit_rate": f"{cache_hit_rate:.1f}%",
        "connection_pool": pool_status,
        "alerts": alerts,
        "healthy": len(alerts) == 0
    }

@app.post("/api/cache/invalidate")
async def invalidate_cache(domain: str = None, pattern: str = None):
    """Invalidate cache entries"""
    memory_cache.invalidate(pattern=pattern, domain=domain)
    return {
        "success": True,
        "message": f"Cache invalidated for domain='{domain}', pattern='{pattern}'"
    }

from pydantic import BaseModel

class ConsolidationRequest(BaseModel):
    domain: str = "default"
    strategy: str = "clustering"

@app.post("/api/consolidation/run")
async def run_consolidation(request: ConsolidationRequest):
    """Run memory consolidation for a domain"""
    try:
        from src.consolidation.postgres_consolidator import PostgreSQLConsolidator
        
        # Build connection string
        connection_string = f"postgresql://{os.getenv('POSTGRES_USER', 'postgres')}:{os.getenv('POSTGRES_PASSWORD', 'postgres')}@{os.getenv('POSTGRES_HOST', 'localhost')}:{int(os.getenv('POSTGRES_PORT', 5432))}/{os.getenv('POSTGRES_DB', 'postgres')}"
        
        # Initialize consolidator
        consolidator = PostgreSQLConsolidator(
            connection_string=connection_string,
            embedding_client=None  # Will use built-in embedding client
        )
        
        # Run consolidation (using the actual method that exists)
        result = await consolidator.consolidate_memories(domain_id=request.domain, days_back=30)
        
        return {
            "success": True,
            "domain": request.domain,
            "strategy": request.strategy,
            "result": result,
            "message": f"Consolidation completed for domain '{request.domain}'"
        }
    except Exception as e:
        return {
            "success": False,
            "error": str(e),
            "message": f"Consolidation failed: {str(e)}"
        }

@app.get("/api/consolidation/status")
async def get_consolidation_status(domain: str = "default"):
    """Get consolidation status for a domain"""
    try:
        from consolidation.health import ConsolidationHealthMonitor
        
        # Initialize health monitor
        monitor = ConsolidationHealthMonitor()
        
        # Get overall health (the monitor doesn't have domain-specific checks)
        health = await monitor.check_overall_health()
        
        return {
            "success": True,
            "domain": domain,
            "health": health,
            "message": f"Overall consolidation health for system"
        }
    except Exception as e:
        return {
            "success": False,
            "error": str(e)
        }

@app.get("/api/project/domain")
async def get_current_project_domain():
