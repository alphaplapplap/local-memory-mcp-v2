#!/bin/bash
# .git/hooks/post-commit

COMMIT_MSG=$(git log -1 --pretty=%B)
BRANCH=$(git branch --show-current)
FILES=$(git diff-tree --no-commit-id --name-only -r HEAD | head -10)
COMMIT_HASH=$(git rev-parse --short HEAD)

# Store in memory service using curl
CONTENT="Git Commit [$COMMIT_HASH] on branch '$BRANCH': $COMMIT_MSG. Files modified: $(echo $FILES | tr '\n' ', ')"

curl -X POST http://localhost:8000/api/memories \
  -H "Content-Type: application/json" \
  -d "{
    \"content\": \"$CONTENT\",
    \"tags\": [\"git\", \"commit\", \"$BRANCH\"],
    \"metadata\": {
      \"commit_hash\": \"$COMMIT_HASH\",
      \"branch\": \"$BRANCH\",
      \"type\": \"git_commit\"
    }
  }" 2>/dev/null | grep -q "id" && echo "✓ Commit stored in memory" || echo "Memory service not available"