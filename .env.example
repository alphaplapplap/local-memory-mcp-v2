# Memory MCP Server Configuration
# Copy this file to .env and update with your values

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ollama Configuration
OLLAMA_API_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
OLLAMA_KEEP_ALIVE=10m

# Bridge Server
BRIDGE_PORT=8000
BRIDGE_API_KEY=test-key-123

# Connection Pool
POOL_MIN_CONNECTIONS=2
POOL_MAX_CONNECTIONS=20

# Cache Configuration
CACHE_TTL=900
CACHE_MAX_SIZE=1000

# Performance Thresholds
PERF_SLOW_QUERY_MS=1000
PERF_MAX_MEMORY_COUNT=10000
PERF_MAX_DB_SIZE_MB=1000

# Consolidation Settings
CONSOLIDATION_ENABLED=true
CONSOLIDATION_SCHEDULE=daily
CONSOLIDATION_STRATEGY=clustering

# Memory Defaults
DEFAULT_MEMORY_DOMAIN=default

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json