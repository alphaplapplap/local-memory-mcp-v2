# Memory MCP Server Configuration
# Copy this file to .env and update with your values

# PostgreSQL Database (Required)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres  # IMPORTANT: Change this in production!

# Ollama Configuration (Required for semantic search)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
OLLAMA_KEEP_ALIVE=10m

# MCP Server Configuration
MCP_SERVER_NAME=Local Context Memory
DEFAULT_MEMORY_DOMAIN=default

# HTTP Bridge Server (for testing/development)
BRIDGE_PORT=8000
BRIDGE_API_KEY=test-key-123

# Connection Pool
POOL_MIN_CONNECTIONS=2
POOL_MAX_CONNECTIONS=20

# Memory System Configuration
MEMORY_MAX_RESULTS=10
MEMORY_MIN_SCORE=0.3
MEMORY_TIMEOUT=5000

# Cache Configuration
CACHE_TTL=900
CACHE_MAX_SIZE=1000

# Performance Thresholds
PERF_SLOW_QUERY_MS=1000
PERF_MAX_MEMORY_COUNT=10000
PERF_MAX_DB_SIZE_MB=1000

# Consolidation Settings
CONSOLIDATION_ENABLED=true
CONSOLIDATION_SCHEDULE=daily
CONSOLIDATION_STRATEGY=clustering

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional: Performance Tuning (uncomment to override defaults)
# MAX_CONTENT_SIZE=5000      # Max characters per memory (default: 100000)
# MAX_METADATA_SIZE=2048     # Max metadata JSON size (default: 10240)
# CHUNK_SIZE=800            # Document chunk size (default: 1000)
# CHUNK_OVERLAP=100         # Chunk overlap size (default: 200)