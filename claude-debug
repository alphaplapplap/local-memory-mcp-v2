#!/bin/bash
# Claude Debug Wrapper - Shows debug output in real-time

# Start tailing the debug log in the background
LOG_FILE="/Users/linuxbabe/Library/Logs/claude-cli-nodejs/-Users-linuxbabe-local-memory-mcp/debug-logs/debug.txt"

# Create log directory if it doesn't exist
mkdir -p "$(dirname "$LOG_FILE")"

# Clear old log
> "$LOG_FILE"

# Start tailing in background
tail -f "$LOG_FILE" 2>/dev/null &
TAIL_PID=$!

# Run claude with debug flag and all arguments
claude --debug "$@"

# Kill the tail process when done
kill $TAIL_PID 2>/dev/null

exit 0